{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal Manifest Protocol",
  "type": "object",
  "required": ["name", "version", "license", "dependencies", "provenance"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "license": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "provenance": { "type": "object" }
  }
}
