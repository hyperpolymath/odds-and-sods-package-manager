# Multi-stage Containerfile for OPSM (Elixir + Rust NIFs)
# Uses Chainguard Wolfi for minimal attack surface
# Build: podman build -t opsm:1.2.0 -f Containerfile .
# Seal:  selur seal opsm:1.2.0
# Sign:  cerro-torre sign opsm:1.2.0

# Stage 1: Rust NIF builder (post-quantum crypto + QUIC transport)
FROM cgr.dev/chainguard/wolfi-base:latest AS rust-builder

RUN apk add --no-cache \
    rust \
    cargo \
    build-base \
    openssl-dev \
    pkgconf

WORKDIR /nif

# Build post-quantum crypto NIF
COPY native/pq_crypto native/pq_crypto
RUN cd native/pq_crypto && cargo build --release

# Build QUIC transport NIF
COPY native/quic_transport native/quic_transport
RUN cd native/quic_transport && cargo build --release

# Stage 2: Elixir build
FROM cgr.dev/chainguard/wolfi-base:latest AS builder

RUN apk add --no-cache \
    elixir \
    erlang \
    git \
    build-base \
    openssl-dev

WORKDIR /build

# Copy mix files first for dependency caching
COPY mix.exs mix.lock ./

RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get --only prod

# Copy application code
COPY lib lib
COPY config config
COPY priv priv

# Copy pre-built Rust NIFs
COPY --from=rust-builder /nif/native/pq_crypto/target/release/libpq_crypto.so priv/native/pq_crypto.so
COPY --from=rust-builder /nif/native/quic_transport/target/release/libquic_transport.so priv/native/quic_transport.so

# Compile release
ENV MIX_ENV=prod
RUN mix deps.compile && \
    mix compile && \
    mix release

# Stage 3: Minimal runtime
FROM cgr.dev/chainguard/wolfi-base:latest

RUN apk add --no-cache \
    libstdc++ \
    openssl \
    ncurses-libs

# Create non-root user
RUN addgroup -g 1000 opsm && \
    adduser -D -u 1000 -G opsm opsm

WORKDIR /app

# Copy release from builder
COPY --from=builder --chown=opsm:opsm /build/_build/prod/rel/opsm ./

# Create directories for state
RUN mkdir -p /app/data /app/cache /app/logs && \
    chown -R opsm:opsm /app

USER opsm

# Health check against the registry gateway
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/app/bin/opsm", "eval", "Opsm.RegistryGateway.Store.health_check()"]

# Expose ports: registry gateway (4050), mobile API (4051)
EXPOSE 4050 4051

# Default command: run OTP application
CMD ["/app/bin/opsm", "start"]

# OCI metadata
LABEL org.opencontainers.image.title="OPSM" \
      org.opencontainers.image.description="Universal package manager with post-quantum crypto, QUIC/HTTP3, and 42 registry adapters" \
      org.opencontainers.image.version="1.2.0" \
      org.opencontainers.image.authors="Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>" \
      org.opencontainers.image.licenses="PMPL-1.0-or-later" \
      org.opencontainers.image.source="https://github.com/hyperpolymath/odds-and-sods-package-manager" \
      org.opencontainers.image.vendor="hyperpolymath" \
      org.opencontainers.image.base.name="cgr.dev/chainguard/wolfi-base:latest"
