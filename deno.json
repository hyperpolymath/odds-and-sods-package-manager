{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "name": "@hyperpolymath/opm",
  "version": "0.1.0",
  "license": "PMPL-1.0",
  "exports": "./cli/main.ts",
  "tasks": {
    "dev": "deno run --allow-read --allow-env --allow-net cli/main.ts",
    "opm": "deno run --allow-read --allow-env --allow-net cli/main.ts",
    "test": "deno test --allow-read --allow-env --allow-net",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check cli/main.ts"
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/toml": "jsr:@std/toml@^1.0.0",
    "@proven/": "../proven/bindings/deno/"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
