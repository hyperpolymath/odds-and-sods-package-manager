{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPM Registry Event",
  "type": "object",
  "required": ["event_type", "package", "version", "timestamp"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "package-published",
        "security-advisory",
        "deprecation-notice",
        "maintainer-change",
        "compatibility-break"
      ]
    },
    "package": { "type": "string" },
    "version": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  }
}
