# Checky-Monkey: Code verification service (fuzzing, property tests, formal verification)
# Rust service with Chainguard Wolfi base

FROM cgr.dev/chainguard/rust:latest AS builder

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm -rf src

COPY src ./src
RUN cargo build --release

FROM cgr.dev/chainguard/wolfi-base:latest

# Install fuzzing tools
RUN apk add --no-cache \
    libgcc \
    libstdc++ \
    afl++ \
    libfuzzer

RUN addgroup -g 1000 checky && \
    adduser -D -u 1000 -G checky checky

WORKDIR /app

COPY --from=builder --chown=checky:checky \
    /build/target/release/checky-monkey /app/

# Verification cache
RUN mkdir -p /cache && chown checky:checky /cache

USER checky

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=3s \
    CMD ["/app/checky-monkey", "health"]

CMD ["/app/checky-monkey", "serve"]

LABEL org.opencontainers.image.title="Checky-Monkey" \
      org.opencontainers.image.description="Code verification and fuzzing service" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.authors="Jonathan D.A. Jewell <jonathan.jewell@open.ac.uk>" \
      org.opencontainers.image.licenses="PMPL-1.0-or-later"
