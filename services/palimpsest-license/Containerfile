# SPDX-License-Identifier: MPL-2.0
# Palimpsest: License analysis and compatibility service
# Rust service with Chainguard Wolfi base

FROM cgr.dev/chainguard/rust:latest AS builder

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm -rf src

COPY src ./src
RUN cargo build --release

FROM cgr.dev/chainguard/wolfi-base:latest

RUN addgroup -g 1000 palimpsest && \
    adduser -D -u 1000 -G palimpsest palimpsest

WORKDIR /app

COPY --from=builder --chown=palimpsest:palimpsest \
    /build/target/release/palimpsest-license /app/

RUN mkdir -p /data && chown palimpsest:palimpsest /data

USER palimpsest

EXPOSE 8082

HEALTHCHECK --interval=30s --timeout=3s \
    CMD ["/app/palimpsest-license", "health"]

CMD ["/app/palimpsest-license"]

LABEL org.opencontainers.image.title="Palimpsest" \
      org.opencontainers.image.description="License analysis and compatibility" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.authors="Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>" \
      org.opencontainers.image.licenses="MPL-2.0"
