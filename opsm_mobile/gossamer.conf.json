{
  "$schema": "https://gossamer.dev/schemas/config/v1",
  "productName": "OPSM Mobile",
  "version": "1.0.1",
  "identifier": "com.hyperpolymath.opsm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "deno task dev",
    "beforeBuildCommand": "deno task build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OPSM - Package Manager",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "maxWidth": null,
        "maxHeight": null,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "alwaysOnTop": false,
        "visible": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:4051 https://*.github.com https://*.gitlab.com; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        "filesystem",
        "network",
        "clipboard"
      ],
      "capabilityTokens": {
        "enabled": false,
        "issuer": "gossamer-runtime",
        "ttl": 3600
      },
      "sandbox": {
        "enabled": true,
        "allowExec": false,
        "allowNetwork": true,
        "allowFilesystem": true
      }
    },
    "ipc": {
      "protocol": "json",
      "bridgeInjection": true,
      "maxMessageSize": 16777216,
      "timeout": 30000
    },
    "tray": {
      "enabled": false,
      "icon": null,
      "tooltip": null,
      "menuOnLeftClick": true
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath)",
    "license": "PMPL-1.0-or-later",
    "shortDescription": "Cross-platform package manager mobile client",
    "longDescription": "OPSM mobile client for searching, installing, and auditing packages across registries",
    "linux": {
      "desktopEntry": true,
      "category": "Development",
      "section": "devel",
      "depends": [],
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macos": {
      "bundleIdentifier": "com.hyperpolymath.opsm",
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "entitlements": null,
      "signingIdentity": null,
      "notarization": {
        "enabled": false,
        "teamId": null
      }
    },
    "windows": {
      "webview2": "embed",
      "certificateThumbprint": null,
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": null
      }
    }
  },
  "ephapax": {
    "modules": [],
    "region": "app",
    "linearVerification": true,
    "regionBoundary": "strict",
    "preload": []
  }
}
