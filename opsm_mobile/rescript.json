{
  "name": "opsm-mobile",
  "version": "1.0.0",
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    }
  ],
  "package-specs": [
    {
      "module": "es6",
      "in-source": true
    }
  ],
  "suffix": ".res.js",
  "bs-dependencies": [
    "@rescript/react",
    "rescript-tea",
    "rescript-tauri",
    "cadre-router",
    "cadre-tea-router"
  ],
  "jsx": {
    "version": 4,
    "mode": "automatic"
  },
  "bsc-flags": [
    "-open RescriptCore"
  ],
  "warnings": {
    "error": "+101+8"
  }
}
