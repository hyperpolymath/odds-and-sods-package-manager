# RSR-compliant .gitignore

# Ada/SPARK
*.ali
/bin/
/obj/

# Build
/_build/
/build/
/dist/
/out/
/target/

# Chapel
*.chpl.tmp.*

# Crash recovery artifacts
ai-cli-crash-capture/

# Dependencies
/.elixir_ls/
/deps/
/node_modules/
/vendor/

# Elixir
*.ez
/cover/
/doc/
erl_crash.dump

# Haskell
/.stack-work/
/dist-newstyle/

# Julia
*.jl.cov
*.jl.mem
/Manifest.toml

# Logs
*.log
/logs/

# NIF build artifacts
opsm_ex/native/*/Cargo.lock
opsm_ex/priv/native/

# OS & Editor
*.swo
*.swp
*~
.DS_Store
.idea/
.vscode/
Thumbs.db

# Python (SaltStack only)
*.py[cod]
.venv/
__pycache__/

# ReScript
*.ast
*.cmt
/.bsb.lock
/lib/bs/

# Rust
# Cargo.lock  # Keep for binaries

# Secrets
*.key
*.pem
.env
.env.*
secrets/

# Temp
*.bak
*.tmp
/tmp/

# Release artifacts
*.tar

# Runtime extension
/runtime/community/*.ncl.bak

# Test/Coverage
/coverage/
htmlcov/

# ReScript/OCaml compiler artifacts
*.cmti
*.cmi

# Zig build artifacts (global)
.zig-cache/
zig-out/
