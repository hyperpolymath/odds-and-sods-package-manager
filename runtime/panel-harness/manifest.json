{"$schema":"https://hyperpolymath.github.io/panll/schemas/panel-manifest-v2.json","actions":[{"command":"opsm runtime install {{tool}} {{version}}","confirm":true,"id":"install","label":"Install Runtime"},{"command":"opsm runtime set {{tool}} {{version}}","confirm":false,"id":"switch","label":"Switch Version"},{"command":"opsm runtime install {{tool}} latest","confirm":true,"id":"update","label":"Update to Latest"},{"command":"opsm runtime uninstall {{tool}} {{version}}","confirm":true,"id":"uninstall","label":"Uninstall"}],"capabilities":{"environment":["read","write"],"filesystem":["read:~/.opsm","write:~/.opsm"],"ipc":["opsm-core"],"network":["github.com","api.github.com"]},"layout":{"default_height":600,"default_width":480,"dockable":["left","right","bottom"],"min_height":400,"min_width":320,"resizable":true},"panel":{"author":"Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>","category":"developer-tools","description":"Visual runtime/tool version management panel for PanLL workspaces","entry":"panel.html","icon":"runtime-icon.svg","id":"opsm-runtime-manager","license":"MPL-2.0","min_panll_version":"0.5.0","name":"OPSM Runtime Manager","runtime":"gossamer","version":"1.0.0"},"panll_integration":{"environment_injection":true,"per_panel_versions":true,"status_bar_widget":{"click_to_switch":true,"show_active_versions":true},"workspace_tool_versions":true},"views":[{"description":"List of installed tools with version status, EOL, CVE badges","id":"installed","name":"Installed Runtimes"},{"description":"Browse and install from core/community plugin catalogue","id":"available","name":"Available Plugins"},{"description":"Per-project .tool-versions management with one-click install","id":"project","name":"Project Versions"},{"description":"OPSM trust pipeline results, attestation scores, SLSA provenance","id":"trust","name":"Trust Dashboard"}]}
