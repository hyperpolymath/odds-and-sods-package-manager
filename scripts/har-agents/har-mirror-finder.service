[Unit]
Description=HAR Mirror Finder Agent
Documentation=https://github.com/hyperpolymath/opm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opm
Group=opm
WorkingDirectory=/var/mnt/eclipse/repos/odds-and-sods-package-manager/scripts/har-agents
ExecStart=/var/mnt/eclipse/repos/odds-and-sods-package-manager/scripts/har-agents/mirror-finder.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp/opm-har-ingest

[Install]
WantedBy=multi-user.target
